# Native macOS full-bundle updater. It uses Apple's Security framework to
# verify the project's existing RSA signing identity (not Apple notarization).
set(_channel "${CMAKE_CURRENT_SOURCE_DIR}/tools/updates/channel.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_channel}")
file(READ "${_channel}" _channel_json)
string(JSON _endpoint GET "${_channel_json}" endpoint)
string(JSON FS26_MACOS_KEY_XML GET "${_channel_json}" public_key_xml)
string(JSON FS26_MACOS_FAMILY GET "${_channel_json}" family)
if(NOT _endpoint MATCHES "^https://[^/]+/.+/latest\\.json$")
  message(FATAL_ERROR "Unexpected FreeShip update endpoint")
endif()
string(REGEX REPLACE "/latest\\.json$" "/macos" _default_base "${_endpoint}")
set(FS26_MACOS_FEED_BASE "${_default_base}" CACHE STRING "HTTPS prefix for macOS feeds: <prefix>/<arch>/latest.json")
if(NOT FS26_MACOS_FEED_BASE MATCHES "^https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+[^/]$" OR FS26_MACOS_FEED_BASE MATCHES "\\.\\./")
  message(FATAL_ERROR "Invalid FS26_MACOS_FEED_BASE")
endif()
set(_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/macos-updater")
configure_file(src/updater/macos_channel.h.in "${_generated}/macos_channel.h" @ONLY)
find_library(FS26_SECURITY_FRAMEWORK Security REQUIRED)
find_library(FS26_COREFOUNDATION_FRAMEWORK CoreFoundation REQUIRED)

function(fs_add_macos_updater target)
  add_executable(${target} src/updater/macos_updater.cpp)
  set_target_properties(${target} PROPERTIES MACOSX_BUNDLE OFF)
  target_include_directories(${target} PRIVATE "${_generated}")
  target_link_libraries(${target} PRIVATE Qt6::Core Qt6::Network "${FS26_SECURITY_FRAMEWORK}" "${FS26_COREFOUNDATION_FRAMEWORK}")
  target_compile_options(${target} PRIVATE -Wall -Wextra)
endfunction()
fs_add_macos_updater(FreeShipUpdater)
add_dependencies(FreeShipQt FreeShipUpdater)
option(FS26_MACOS_UPDATE_TESTS "Build a loopback-only fixture updater; never ship it" OFF)
if(FS26_MACOS_UPDATE_TESTS)
  fs_add_macos_updater(FreeShipUpdaterTest)
  target_compile_definitions(FreeShipUpdaterTest PRIVATE FS26_MACOS_UPDATE_TEST=1)
endif()
