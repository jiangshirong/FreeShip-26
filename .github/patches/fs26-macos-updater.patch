+#ifdef Q_OS_MACOS
+static int verifyMacosCheck(const QString& out){
+    QWidget owner;owner.resize(1040,600);owner.show();
+    QAction about(&owner);
+    StudioUpdateController controller(&owner,&about,false,[](std::function<void()>){ });
+    bool visible=false;
+    QTimer::singleShot(0,&owner,[&]{
+        auto* dialog=owner.findChild<QDialog*>("FreeShipAbout");
+        auto* button=dialog?dialog->findChild<QPushButton*>("AboutUpdateLatest"):nullptr;
+        visible=button&&button->isVisible()&&button->text()==uiText("检查更新");
+        if(visible)button->click();else if(dialog)dialog->reject();
+    });
+    QTimer::singleShot(2000,&owner,[&]{if(auto* dialog=owner.findChild<QDialog*>("FreeShipAbout"))dialog->reject();});
+    showFreeShipAbout(&owner);
+    QElapsedTimer wait;wait.start();
+    while(visible&&(controller.state().isEmpty()||controller.lastRequestedMode().isEmpty())&&wait.elapsed()<12000){
+        QCoreApplication::processEvents(QEventLoop::AllEvents,25);
+    }
+    const bool pass=visible&&controller.lastRequestedMode()=="--check"&&controller.state()=="current"&&
+        owner.findChild<QDialog*>("FreeShipUpdate")!=nullptr;
+    QFile report(out+"/report.json");
+    if(!report.open(QIODevice::WriteOnly))return 2;
+    report.write(QJsonDocument(QJsonObject{{"status",pass?"pass":"fail"},{"entry_visible",visible},
+        {"requested_mode",controller.lastRequestedMode()},{"state",controller.state()}}).toJson());
+    return pass?0:1;
+}
+#endif
+
