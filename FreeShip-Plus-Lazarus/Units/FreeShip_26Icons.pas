function HasFreeShip_26Icon(const Name:string):Boolean;
begin Result:=FreeShip_26IconKey(Name)<>'' end;
procedure LoadFreeShip_26Icon(Destination:TGraphic; const Name:string; Size:Integer);
var Pic:TPicture; ResourceName,Candidate,Key:string; N,Distance,BestDistance:Integer;
const Sizes:array[0..11]of Integer=(16,20,22,24,25,30,32,40,48,64,96,128);
begin
  Key:=FreeShip_26IconKey(Name);
  if Key='' then raise Exception.Create('Unknown FreeShip_26 icon: '+Name);
  ResourceName:='FreeShip_26/'+Key+'/'+IntToStr(Size);
  // Nonstandard display scales use the closest available vector raster size.
  if LazarusResources.Find(ResourceName)=nil then begin
    BestDistance:=MaxInt;
    for N in Sizes do begin
      Candidate:='FreeShip_26/'+Key+'/'+IntToStr(N);
      Distance:=Abs(Size-N);
      if (LazarusResources.Find(Candidate)<>nil) and (Distance<=BestDistance) then begin
        BestDistance:=Distance;ResourceName:=Candidate;
      end;
    end;
  end;
  Pic:=TPicture.Create;
  try
    Pic.LoadFromLazarusResource(ResourceName);
    Destination.Assign(Pic.Graphic);
  finally Pic.Free end;
end;
