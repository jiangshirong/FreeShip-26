#: freehydrostaticsfrm.rshydrodraftfinite
msgid "Draft values and step must be finite numbers."
msgstr "吃水和步长必须是有限数值。"

#: freehydrostaticsfrm.rshydrodraftrange
msgid "The end draft must not be below the start draft, and the step must be positive."
msgstr "结束吃水不能小于起始吃水，步长必须大于零。"

#: freehydrostaticsfrm.rshydrodraftrows
#, object-pascal-format
msgid "Too many draft rows. Increase the step (maximum %d rows)."
msgstr "吃水行数过多，请增大步长（最多 %d 行）。"

#: freehydrostaticsfrm.rshydrodraftprecision
msgid "The draft step is too small for the precision of these draft values."
msgstr "当前步长过小，超出这些吃水数值可表示的精度。"

#: freeshipunit.rshydroauxinputs
msgid "Additional tables were not generated: use between 1 and 99 waterlines and at most 99 stations."
msgstr "未生成附加数据表：需要 1～99 条水线，站线不能超过 99 条。"

#: freeshipunit.rshydroauxincomplete
msgid "Additional tables were not generated because the hydrostatic calculation is incomplete."
msgstr "静水力计算未完成，未生成附加数据表。"

#: freeshipunit.rshydroauxinvalidwaterline
msgid "Additional tables were not generated: a selected waterline has an invalid submerged hull."
msgstr "部分水线的浸水船体计算有误，未生成附加数据表。"

#: freeshipunit.rshydroauxnostations
msgid "SACs.txt and Bonjean.txt were not generated because no stations are defined. Weights.txt and Sterns.txt are available."
msgstr "未定义站线，未生成 SACs.txt 和 Bonjean.txt；仍可保存 Weights.txt 和 Sterns.txt。"

#: freehydrostaticsdlg.rshydroreportsaved
#, object-pascal-format
msgid "Report saved. Additional tables (%s):%s%s"
msgstr "报告已保存。附加数据表（%s）保存在：%s%s"

#: freehydrostaticsdlg.rshydroauxcreatefailed
#, object-pascal-format
msgid "Report saved, but additional tables could not be saved to %s."
msgstr "报告已保存，但无法将附加数据表保存到 %s。"

#: freehydrostaticsdlg.rshydroauxwritefailed
#, object-pascal-format
msgid "Report saved, but additional tables are incomplete in %s: %s"
msgstr "报告已保存，但 %s 中的附加数据表尚未写入完整：%s"

#: freehydrostaticsdlg.rshydrosavefailed
#, object-pascal-format
msgid "Could not save report to %s: %s"
msgstr "无法将报告保存到 %s：%s"

#: freehydrostaticsdlg.rshydrosavehint
msgid "Save the report and additional tables in a new <report>-data folder."
msgstr "保存报告，并将附加数据表放入新建的“报告名-data”文件夹。"

#: tfreeprojectsettingsdialog.checkbox14.hint
msgctxt "tfreeprojectsettingsdialog.checkbox14.hint"
msgid "Save additional tables with the hydrostatic report in a new <report>-data folder."
msgstr "保存静水力报告时，将附加数据表放入新建的“报告名-data”文件夹。"

